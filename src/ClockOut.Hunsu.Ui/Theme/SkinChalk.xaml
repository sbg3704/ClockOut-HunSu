<!-- 기능: 패널 룩 "C 먹빛 유리와 분필"의 색·모서리·손그림 값. Theme.xaml과 같은 이름의 값만 다시 정한다(손그림 종류와 선 색은 이 룩만의 이름 Hunsu.Skin.*). -->
<!-- 사용법: 앱이 켜질 때 settings.json의 skin이 이 룩이면 ThemePicker가 Theme.xaml(밝은 룩은 ThemeLight.xaml도) 뒤에 합친다. 바꾸면 껐다 켠다. 모듈은 이 파일을 모른다. -->
<!-- 의존: 이름은 Theme.xaml과 같아야 한다. Hunsu.Skin.Kind는 Core/Settings/SkinChoice의 SkinKind 이름. 그리는 쪽은 Frame/HandFrame. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="Hunsu.GlassColor">#EA161929</Color>
  <SolidColorBrush x:Key="Hunsu.Glass" Color="#EA161929" />
  <SolidColorBrush x:Key="Hunsu.Surface" Color="#161929" />
  <SolidColorBrush x:Key="Hunsu.GlassAlt" Color="#10FFFFFF" />
  <SolidColorBrush x:Key="Hunsu.GlassHover" Color="#1CFFFFFF" />
  <SolidColorBrush x:Key="Hunsu.Line" Color="#26E4E6F6" />
  <SolidColorBrush x:Key="Hunsu.Text" Color="#EEF0FA" />
  <SolidColorBrush x:Key="Hunsu.Muted" Color="#969CBE" />
  <SolidColorBrush x:Key="Hunsu.Accent" Color="#5AC8FF" />
  <SolidColorBrush x:Key="Hunsu.AccentInk" Color="#0A1020" />
  <SolidColorBrush x:Key="Hunsu.Tone.Info" Color="#5AC8FF" />
  <SolidColorBrush x:Key="Hunsu.Tone.Good" Color="#6EEBAA" />
  <SolidColorBrush x:Key="Hunsu.Tone.Warn" Color="#FFCE50" />
  <SolidColorBrush x:Key="Hunsu.Tone.Bad" Color="#FF6078" />
  <SolidColorBrush x:Key="Hunsu.Tone.Muted" Color="#969CBE" />
  <CornerRadius x:Key="Hunsu.PanelRadius">7</CornerRadius>
  <sys:Double x:Key="Hunsu.FontPanelTitle">17</sys:Double>
  <!-- 손그림: 분필 선(덧그림) + 제목줄 아래 네온 밑줄 -->
  <sys:String x:Key="Hunsu.Skin.Kind">Chalk</sys:String>
  <SolidColorBrush x:Key="Hunsu.Skin.Frame" Color="#E4E6F6" />
  <SolidColorBrush x:Key="Hunsu.Skin.Swash" Color="#5AC8FF" />
  <sys:Double x:Key="Hunsu.Skin.FrameWidth">1.7</sys:Double>
</ResourceDictionary>
