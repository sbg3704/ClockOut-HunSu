<!-- 기능: 패널 룩 "A 색연필 노트"의 색·모서리·손그림 값. Theme.xaml과 같은 이름의 값만 다시 정한다(손그림 종류와 선 색은 이 룩만의 이름 Hunsu.Skin.*). -->
<!-- 사용법: 앱이 켜질 때 settings.json의 skin이 이 룩이면 ThemePicker가 Theme.xaml(밝은 룩은 ThemeLight.xaml도) 뒤에 합친다. 바꾸면 껐다 켠다. 모듈은 이 파일을 모른다. -->
<!-- 의존: 이름은 Theme.xaml과 같아야 한다. Hunsu.Skin.Kind는 Core/Settings/SkinChoice의 SkinKind 이름. 그리는 쪽은 Frame/HandFrame. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="Hunsu.GlassColor">#F5FDF7E8</Color>
  <SolidColorBrush x:Key="Hunsu.Glass" Color="#F5FDF7E8" />
  <SolidColorBrush x:Key="Hunsu.Surface" Color="#FDF7E8" />
  <SolidColorBrush x:Key="Hunsu.GlassAlt" Color="#10342F3C" />
  <SolidColorBrush x:Key="Hunsu.GlassHover" Color="#1C342F3C" />
  <SolidColorBrush x:Key="Hunsu.Line" Color="#22342F3C" />
  <SolidColorBrush x:Key="Hunsu.Text" Color="#342F3C" />
  <SolidColorBrush x:Key="Hunsu.Muted" Color="#6E646E" />
  <SolidColorBrush x:Key="Hunsu.Accent" Color="#D9503F" />
  <SolidColorBrush x:Key="Hunsu.AccentInk" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Hunsu.Tone.Info" Color="#3F78CD" />
  <SolidColorBrush x:Key="Hunsu.Tone.Good" Color="#3A9A69" />
  <SolidColorBrush x:Key="Hunsu.Tone.Warn" Color="#B87610" />
  <SolidColorBrush x:Key="Hunsu.Tone.Bad" Color="#D9503F" />
  <SolidColorBrush x:Key="Hunsu.Tone.Muted" Color="#6E646E" />
  <CornerRadius x:Key="Hunsu.PanelRadius">5</CornerRadius>
  <sys:Double x:Key="Hunsu.FontPanelTitle">17</sys:Double>
  <!-- 손그림: 연필 테두리(덧그림) + 제목줄 색연필 빗금 + 종이 결 -->
  <sys:String x:Key="Hunsu.Skin.Kind">Pencil</sys:String>
  <SolidColorBrush x:Key="Hunsu.Skin.Frame" Color="#46424E" />
  <SolidColorBrush x:Key="Hunsu.Skin.Swash" Color="#D9503F" />
  <sys:Double x:Key="Hunsu.Skin.FrameWidth">1.9</sys:Double>
</ResourceDictionary>
