<!-- 기능: 모든 패널이 쓰는 같은 틀(docs/01 9장 6번). 제목줄 36(제목, 투명도, 핀, 접기 단추) + 내용. 어두운 유리 바탕, 반경 12, 그림자 1단. -->
<!-- 사용법: <frame:PanelFrame Title="선택 요약" Body="{...}" /> 단추 이벤트는 PanelFrame.xaml.cs. 제목줄을 누르고 끌면 TitleDragStarted. -->
<UserControl x:Class="ClockOut.Hunsu.Ui.Frame.PanelFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border x:Name="Card" CornerRadius="{StaticResource Hunsu.PanelRadius}" Background="{StaticResource Hunsu.Glass}"
          BorderBrush="{StaticResource Hunsu.Line}" BorderThickness="1" Effect="{StaticResource Hunsu.Shadow1}">
    <!-- 그림자와 둥근 테두리를 한 번 그려 두고 움직임(투명도·이동) 동안 다시 그리지 않게 한다(1단계 측정: 움직임 중 프레임 건너뜀). -->
    <Border.CacheMode>
      <BitmapCache SnapsToDevicePixels="True" />
    </Border.CacheMode>
    <DockPanel>
      <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="{StaticResource Hunsu.TitleBarHeight}" Background="Transparent"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="8,0,4,0" VerticalAlignment="Center" LastChildFill="True">
          <Border x:Name="Dot" DockPanel.Dock="Left" Width="5" Height="5" CornerRadius="3" Background="{StaticResource Hunsu.Accent}" Margin="0,0,6,0" />
          <TextBlock x:Name="TitleText" FontFamily="{StaticResource Hunsu.FontTitle}" FontSize="{StaticResource Hunsu.FontSmall}"
                     FontWeight="SemiBold" Foreground="{StaticResource Hunsu.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,2,0">
          <Button x:Name="LockButton" Style="{StaticResource Hunsu.IconButton}" Content="&#xE785;" ToolTip="이 패널 자리 잠그기" Visibility="Collapsed" Click="LockButton_Click" />
          <Button x:Name="OpacityButton" Style="{StaticResource Hunsu.IconButton}" FontFamily="Segoe UI Symbol" Content="◐"
                  ToolTip="투명도" Click="OpacityButton_Click" />
          <Button x:Name="PinButton" Style="{StaticResource Hunsu.IconButton}" Content="&#xE718;" ToolTip="떼어 내기(핀 창)" Click="PinButton_Click" />
          <Button x:Name="CollapseButton" Style="{StaticResource Hunsu.IconButton}" Content="&#xE70E;" ToolTip="접기" Click="CollapseButton_Click" />
        </StackPanel>
      </Grid>
      <!-- 핀 창을 줄이면 내용이 넘칠 수 있어 휠로 내린다(스크롤 막대는 숨김: 유리 바탕을 가리지 않게). 도크에서는 높이 제한이 없어 그대로다. -->
      <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" PanningMode="VerticalOnly">
        <ContentPresenter x:Name="BodyHost" Margin="{StaticResource Hunsu.PanelPadding}" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
