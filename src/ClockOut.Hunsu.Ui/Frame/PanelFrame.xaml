<!-- 기능: 모든 패널이 쓰는 같은 틀(docs/01 9장 6번). 제목줄 36(제목, 투명도, 핀, 접기 단추) + 내용. 어두운 유리 바탕, 반경 12, 그림자 1단. -->
<!-- 사용법: <frame:PanelFrame Title="선택 요약" Body="{...}" /> 단추 이벤트는 PanelFrame.xaml.cs. 제목줄을 누르고 끌면 TitleDragStarted. -->
<UserControl x:Class="ClockOut.Hunsu.Ui.Frame.PanelFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClockOut.Hunsu.Ui.Frame"
             x:Name="Self" Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border x:Name="Card" CornerRadius="{DynamicResource Hunsu.PanelRadius}" Background="{StaticResource Hunsu.Glass}"
          BorderBrush="{StaticResource Hunsu.Line}" BorderThickness="1" Effect="{StaticResource Hunsu.Shadow1}">
    <!-- 그림자와 둥근 테두리를 한 번 그려 두고 움직임(투명도·이동) 동안 다시 그리지 않게 한다(1단계 측정: 움직임 중 프레임 건너뜀). -->
    <Border.CacheMode>
      <BitmapCache SnapsToDevicePixels="True" />
    </Border.CacheMode>
    <Grid>
    <DockPanel>
      <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="{StaticResource Hunsu.TitleBarHeight}" Background="Transparent"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- 투명도 막대: ◐ 단추를 누르면 제목 대신 나타나 아날로그로 조절한다(높이가 변하지 않게 제목 자리에 겹침). -->
        <Slider x:Name="AlphaSlider" Visibility="Collapsed" Margin="8,0,4,0" VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True"
                Minimum="0.2" Maximum="1" SmallChange="0.02" LargeChange="0.1" ToolTip="투명도(밀어서 조절)" ValueChanged="AlphaSlider_ValueChanged" />
        <DockPanel x:Name="TitleRow" Margin="8,0,4,0" VerticalAlignment="Center" LastChildFill="True">
          <Border x:Name="Dot" DockPanel.Dock="Left" Width="5" Height="5" CornerRadius="3" Background="{StaticResource Hunsu.Accent}" Margin="0,0,6,0" />
          <TextBlock x:Name="TitleText" FontFamily="{DynamicResource Hunsu.FontTitle}" FontSize="{DynamicResource Hunsu.FontPanelTitle}"
                     FontWeight="SemiBold" Foreground="{StaticResource Hunsu.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,2,0">
          <Button x:Name="LockButton" Style="{StaticResource Hunsu.IconButton}" Content="&#xE785;" ToolTip="이 패널 자리 잠그기" Visibility="Collapsed" Click="LockButton_Click" />
          <Button x:Name="PowerButton" Style="{StaticResource Hunsu.IconButton}" Content="&#xE7E8;" Visibility="Collapsed" ToolTip="켜고 끄기" Click="PowerButton_Click" />
          <Button x:Name="OpacityButton" Style="{StaticResource Hunsu.IconButton}" FontFamily="Segoe UI Symbol" Content="◐"
                  ToolTip="투명도: 누르면 막대" Click="OpacityButton_Click" />
          <Button x:Name="PinButton" Style="{StaticResource Hunsu.IconButton}" Content="&#xE718;" ToolTip="떼어 내기(핀 창)" Click="PinButton_Click" />
          <Button x:Name="CollapseButton" Style="{StaticResource Hunsu.IconButton}" Content="&#xE70E;" ToolTip="작게(아이콘으로)" Click="CollapseButton_Click" />
        </StackPanel>
      </Grid>
      <!-- 내용이 넘치면 휠로 내리고, 넘칠 때만 가는 막대가 나온다(유리 바탕을 가리지 않게 6px 둥근 막대). 모든 패널 본문의 기본 동작이다. -->
      <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
          <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="7" />
            <Setter Property="MinWidth" Value="7" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Grid Background="Transparent" Width="7">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                      <Track.Thumb>
                        <Thumb>
                          <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                              <Border CornerRadius="3" Margin="1,0" Opacity="0.65" Background="{DynamicResource Hunsu.Muted}" />
                            </ControlTemplate>
                          </Thumb.Template>
                        </Thumb>
                      </Track.Thumb>
                    </Track>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ScrollViewer.Resources>
        <ContentPresenter x:Name="BodyHost" Margin="{StaticResource Hunsu.PanelPadding}" />
      </ScrollViewer>
    </DockPanel>
      <!-- 손그림 룩(skin)의 테두리·제목줄 장식. 룩이 plain이면 아무것도 그리지 않는다. 클릭은 그대로 아래로 지나간다. -->
      <local:HandFrame x:Name="Hand" TitleHeight="{StaticResource Hunsu.TitleBarHeight}" IsHitTestVisible="False" />
    </Grid>
  </Border>
</UserControl>
