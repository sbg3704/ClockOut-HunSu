<!-- 기능: 앱 시작점과 공용 자원(Ui의 Theme). 시작 순서는 App.xaml.cs → Shell/ShellController. -->
<Application x:Class="ClockOut.Hunsu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ClockOut.Hunsu.Ui;component/Theme/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
