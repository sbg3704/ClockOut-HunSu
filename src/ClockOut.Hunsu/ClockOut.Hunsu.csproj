<!-- 기능: 훈수꾼 실행 파일(WPF). 도크·핀 창, 엑셀 창 따라가기, 신호 받기, 엑셀 조회, 모듈 불러오기, 배치 저장, 단축키, 알림 영역 아이콘. -->
<!-- 사용법: dotnet build 뒤 ClockOut.Hunsu.exe 실행(인자 없이 = 보이는 엑셀 창을 따라감). 인자는 Core/AppOptions.cs -->
<!-- 의존: ClockOut.Hunsu.Core, ClockOut.Hunsu.Ui. 알림 영역 아이콘에 WinForms NotifyIcon을 쓴다(WPF에 없음). 모듈 폴더(modules/)를 실행 파일 옆으로 복사한다. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClockOut.Hunsu</AssemblyName>
    <RootNamespace>ClockOut.Hunsu</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\hunsu.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO0003: WinForms 앱용 안내(DPI를 Application.SetHighDpiMode로). 이 앱은 WPF이고 WinForms는 알림 아이콘에만 쓰므로 매니페스트(PerMonitorV2)를 유지한다. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <!-- 판 번호 뒤에 "이 PR에서 몇 번째 작업인지"(main 뒤로 쌓인 커밋 수 → a, b, c...), co가 넣는 꼬리표(HUNSU_BUILD_TAG, 예 pr20), 짧은 커밋을 붙여 같은 판의 시험 빌드를 구별한다: v0.0.020c pr20 abc1234. git이 없으면 판 번호만. -->
  <Target Name="HunsuStamp" BeforeTargets="InitializeSourceControlInformation">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="HunsuSha" />
    </Exec>
    <Exec Command="git rev-list --count origin/main..HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="HunsuCount" />
    </Exec>
    <PropertyGroup>
      <HunsuCount Condition="'$(HunsuCount)' == '' Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(HunsuCount)', '^[0-9]+$'))">0</HunsuCount>
      <SourceRevisionId Condition="'$(HunsuSha)' != ''">$(HunsuCount).$(HunsuSha)</SourceRevisionId>
      <SourceRevisionId Condition="'$(HunsuSha)' != '' And '$(HUNSU_BUILD_TAG)' != ''">$(HUNSU_BUILD_TAG).$(HunsuCount).$(HunsuSha)</SourceRevisionId>
    </PropertyGroup>
  </Target>
  <ItemGroup>
    <!-- WinForms의 Application, MessageBox 등과 WPF 이름이 겹치지 않게 암묵 using에서 뺀다(NotifyIcon만 이름을 다 적어 쓴다). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- 고양이 아이콘: 실행 파일 아이콘이자 알림 영역 아이콘 원본. 원본 SVG는 assets/icon, 만드는 법은 tools/icons/make_app_icon.mjs. -->
    <EmbeddedResource Include="Assets\hunsu.ico" LogicalName="hunsu.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClockOut.Hunsu.Core\ClockOut.Hunsu.Core.csproj" />
    <ProjectReference Include="..\ClockOut.Hunsu.Ui\ClockOut.Hunsu.Ui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\modules\**\*" Link="modules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
