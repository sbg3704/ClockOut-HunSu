<!-- 기능: 엑셀 위에 겹치는 투명 창 한 개. 바탕은 완전 투명(알파 0)이라 클릭이 아래 엑셀로 지나가고, 알약(Pill)과 펼친 패널만 클릭을 받는다. -->
<!-- 사용법: OverlayWindow.xaml.cs가 값 넣기와 패널 열고 닫기를 맡는다. 색과 시간은 Theme/Theme.xaml에서. -->
<Window x:Class="ClockOut.Hunsu.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="훈수꾼" Width="380" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{StaticResource Hunsu.Font}" FontSize="{StaticResource Hunsu.FontBody}"
        TextOptions.TextFormattingMode="Display">
  <Grid x:Name="Root" Background="Transparent">
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
      <Border x:Name="Pill" HorizontalAlignment="Right" CornerRadius="{StaticResource Hunsu.PillRadius}"
              Background="{StaticResource Hunsu.Glass}" BorderBrush="{StaticResource Hunsu.Line}" BorderThickness="1"
              Padding="5,4,12,4" Cursor="Hand" MouseLeftButtonUp="Pill_MouseLeftButtonUp">
        <StackPanel Orientation="Horizontal">
          <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Hunsu.Accent}">
            <TextBlock Text="훈" FontWeight="Bold" Foreground="{StaticResource Hunsu.AccentInk}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="SummaryText" Text="훈수 대기 중" Margin="8,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource Hunsu.Text}" />
        </StackPanel>
      </Border>
      <Border x:Name="Panel" HorizontalAlignment="Right" Width="300" Margin="0,8,0,0" Visibility="Collapsed" Opacity="0"
              CornerRadius="{StaticResource Hunsu.PanelRadius}" Background="{StaticResource Hunsu.Glass}"
              BorderBrush="{StaticResource Hunsu.Line}" BorderThickness="1">
        <Border.RenderTransform>
          <TranslateTransform x:Name="PanelShift" Y="6" />
        </Border.RenderTransform>
        <StackPanel Margin="14,12,14,12">
          <TextBlock Text="선택 요약" FontWeight="SemiBold" Foreground="{StaticResource Hunsu.Accent}" />
          <TextBlock x:Name="PanelAddr" Text="-" Margin="0,6,0,0" Foreground="{StaticResource Hunsu.Text}" />
          <TextBlock x:Name="PanelDetail" Text="엑셀에서 칸을 고르면 여기에 요약이 나옵니다." Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource Hunsu.Muted}" FontSize="{StaticResource Hunsu.FontSmall}" />
          <TextBlock x:Name="PanelStatus" Text="연결 기다리는 중" Margin="0,8,0,0"
                     Foreground="{StaticResource Hunsu.Muted}" FontSize="{StaticResource Hunsu.FontSmall}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>
